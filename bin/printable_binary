#!/usr/bin/env luajit

-- PrintableBinary: A utility to encode/decode binary data into human-readable UTF-8
-- Module definition
local PrintableBinary = {}

local encode_map = {} -- number (0-255) -> string (UTF-8 bytes)
local decode_map = {} -- string (UTF-8 bytes) -> number (0-255)

local control_names = {
  "NUL", "SOH", "STX", "ETX", "EOT", "ENQ", "ACK", "BEL",
  "BS", "TAB", "LF", "VT", "FF", "CR", "SO", "SI",
  "DLE", "DC1", "DC2", "DC3", "DC4", "NAK", "SYN", "ETB",
  "CAN", "EM", "SUB", "ESC", "FS", "GS", "RS", "US"
}

local function ascii_name(byte_val)
  if byte_val <= 31 then
    return control_names[byte_val + 1]
  elseif byte_val == 32 then
    return "SPACE"
  elseif byte_val == 127 then
    return "DEL"
  elseif byte_val >= 33 and byte_val <= 126 then
    local ch = string.char(byte_val)
    if ch == "\\" or ch == "'" then
      ch = "\\" .. ch
    end
    return "'" .. ch .. "'"
  else
    return string.format("0x%02X", byte_val)
  end
end

local function json_escape(str)
  local escaped = str:gsub('[\\"]', { ['\\'] = '\\\\', ['"'] = '\\"' })
  escaped = escaped:gsub("[%z\1-\31]", function(c)
    return string.format("\\u%04X", string.byte(c))
  end)
  return escaped
end

local function csv_escape(str)
  return '"' .. str:gsub('"', '""') .. '"'
end

local function build_mapping_entries()
  local entries = {}
  for byte_val = 0, 255 do
    local mapping = encode_map[byte_val] or ""
    entries[#entries + 1] = {
      byte = byte_val,
      hex = string.format("0x%02X", byte_val),
      dec = byte_val,
      ascii = ascii_name(byte_val),
      mapping = mapping
    }
  end
  return entries
end

function PrintableBinary.get_mappings()
  return build_mapping_entries()
end

local function output_mappings(format)
  local entries = PrintableBinary.get_mappings()
  if format == "json" then
    local fragments = {}
    for _, entry in ipairs(entries) do
      fragments[#fragments + 1] = string.format(
        '{"byte":%d,"hex":"%s","dec":%d,"ascii":"%s","mapping":"%s"}',
        entry.byte,
        entry.hex,
        entry.dec,
        json_escape(entry.ascii),
        json_escape(entry.mapping)
      )
    end
    io.write("[" .. table.concat(fragments, ",") .. "]\n")
  elseif format == "csv" then
    io.write("byte,hex,dec,ascii,mapping\n")
    for _, entry in ipairs(entries) do
      io.write(string.format(
        "%d,%s,%d,%s,%s\n",
        entry.byte,
        entry.hex,
        entry.dec,
        csv_escape(entry.ascii),
        csv_escape(entry.mapping)
      ))
    end
  else
    io.write(string.format("%-6s %-5s %-12s %s\n", "Byte", "Dec", "ASCII", "Mapping"))
    for _, entry in ipairs(entries) do
      io.write(string.format("%-6s %-5d %-12s %s\n", entry.hex, entry.dec, entry.ascii, entry.mapping))
    end
  end
end

-- Helper to define an encoding and its reverse mapping
local function def_char(byte_val, utf8_str)
  encode_map[byte_val] = utf8_str
  decode_map[utf8_str] = byte_val
end

local function load_character_map()
  local candidates = {}

  local env_path = os.getenv("PRINTABLE_BINARY_MAP")
  if env_path and #env_path > 0 then
    table.insert(candidates, env_path)
  end

  local source = debug.getinfo(1, "S").source
  if source:sub(1, 1) == '@' then
    local script_path = source:sub(2):gsub('\\', '/')
    local dir = script_path:match("(.*/)")
    if dir then
      table.insert(candidates, dir .. "character_map.txt")
    end
  end

  table.insert(candidates, "character_map.txt")

  for _, path in ipairs(candidates) do
    local file = io.open(path, "r")
    if file then
      local map = {}
      local index = 0
      for line in file:lines() do
        if index >= 256 then break end
        line = line:gsub("\r$", "")
        map[index] = line
        index = index + 1
      end
      file:close()
      if index == 256 then
        return map
      end
    end
  end

  return nil
end

local function build_maps()
  local map = load_character_map()
  if not map then
    error("Unable to load character_map.txt. Set PRINTABLE_BINARY_MAP or run from the repository root.")
  end

  for i = 0, 255 do
    local ch = map[i]
    if not ch then
      error(string.format("Character map missing entry at index %d", i))
    end
    def_char(i, ch)
  end
end

-- Build the encoding maps when module is loaded
build_maps()

-- Encode binary data to printable UTF-8
function PrintableBinary.encode(binary_data, options)
  if type(binary_data) ~= "string" then
    error("Input must be a string")
  end

  options = options or {}
  local spaces_mode = options.spaces == true
  local result = {}

  for i = 1, #binary_data do
    local byte = string.byte(binary_data, i)
    if spaces_mode and byte == 32 then
      result[i] = " "
    else
      result[i] = encode_map[byte]
    end
  end

  return table.concat(result)
end

-- Decode printable UTF-8 back to binary
local function warn_spaces_after_newline(str)
  if str:match("\r\n  +") or str:match("\n  +") or str:match("\r  +") then
    io.stderr:write("Warning: spaces after newline are treated as data in --spaces mode\n")
  end
end

function PrintableBinary.decode(printable_string, options)
  if type(printable_string) ~= "string" then
    error("Input must be a string")
  end

  options = options or {}
  local spaces_mode = options.spaces == true
  local skip_clean = options.skip_clean == true
  local warn_on_indent = options.warn_on_indent == true

  -- For debugging
  local debug_mode = os.getenv("DEBUG")
  local function debug_print(msg)
    if debug_mode then
      io.stderr:write("# DEBUG DECODE: " .. msg .. "\n")
    end
  end

  -- Clean up the input string
  if spaces_mode and warn_on_indent then
    warn_spaces_after_newline(printable_string)
  end

  local cleaned_string = printable_string
  if not skip_clean then
    if spaces_mode then
      cleaned_string = cleaned_string:gsub("[\r\n\t]", "")
    else
      cleaned_string = cleaned_string:gsub("[\r\n\t ]", "")
    end
  end

  debug_print("Input length: " .. #printable_string .. ", Cleaned length: " .. #cleaned_string)

  -- Now proceed with normal decoding
  local result_bytes_as_chars = {}
  local i = 1
  local s_len = #cleaned_string

  -- Process the string one character at a time
  while i <= s_len do
    local matched_char = nil

    if spaces_mode and cleaned_string:sub(i, i) == " " then
      result_bytes_as_chars[#result_bytes_as_chars + 1] = " "
      i = i + 1
      matched_char = " "
    end

    -- Try to match longest first (3-byte, then 2-byte, then 1-byte)
    -- Max UTF-8 char length in our set is 3 bytes
    if not matched_char then
      for len = 4, 1, -1 do
        if i + len - 1 <= s_len then
          local sub = string.sub(cleaned_string, i, i + len - 1)
          if decode_map[sub] then
            result_bytes_as_chars[#result_bytes_as_chars + 1] = string.char(decode_map[sub])
            i = i + len
            matched_char = sub
            break
          end
        end
      end
    end

    -- If we didn't match any character in our map, just skip this byte
    if not matched_char then
      local byte_repr = ""
      for j = 0, math.min(2, s_len - i) do
        if i + j <= s_len then
          local b = string.byte(cleaned_string, i + j)
          byte_repr = byte_repr .. string.format(" %02X", b)
        end
      end

      debug_print("Unrecognized character at position " .. i .. ", bytes:" .. byte_repr)
      i = i + 1
    end
  end

  local result = table.concat(result_bytes_as_chars)
  debug_print("Decoded " .. #cleaned_string .. " input bytes to " .. #result .. " output bytes")

  return result
end

-- If running as a script rather than being required as a module
if arg then
  local function print_usage()
    local progname = arg[0] or "printable_binary"

    io.stderr:write("PrintableBinary - Encode binary data as printable UTF-8 and decode it back\n\n")
    io.stderr:write("Usage: " .. progname .. " [options] [file]\n")
    io.stderr:write("Options:\n")
    io.stderr:write("  -d, --decode     Decode mode (default is encode mode)\n")
    io.stderr:write("  -p, --passthrough  Pass input to stdout unchanged, send encoded data to stderr\n")
    io.stderr:write("  -s, --spaces     Preserve literal spaces (decoder still ignores tabs/newlines/CR)\n")
    io.stderr:write("  -f[=NxM], --format[=NxM]   Format output in groups\n")
    io.stderr:write("                    Default: 8x10 (groups of 8 chars, 10 groups per line)\n")
    io.stderr:write("  --mappings       Show the current byte-to-character mapping table\n")
    io.stderr:write("  --mappings-json  Output mappings as JSON\n")
    io.stderr:write("  --mappings-csv   Output mappings as CSV\n")
    io.stderr:write("  -h, --help       Show this help\n")
    io.stderr:write("\n")
    io.stderr:write("If no file is specified, input is read from stdin.\n")
    io.stderr:write("Output is written to stdout, unless --passthrough is used (see below).\n\n")
    io.stderr:write("PrintableBinary encodes every byte (including quotes, backslashes, tabs, CR/LF, etc.) into visible, but clearly related, glyphs.\n")
    io.stderr:write("You can format the encoded text however you like—spaces, newlines, indentation—because the decoder ignores real whitespace.\n")
    io.stderr:write("With --spaces, literal spaces are treated as data (and we warn on indented lines).\n")
    io.stderr:write("Examples: SPACE→␣, TAB→⇥, CR→⏎, LF→↧, single quote→ʼ, double quote→˵, backslash→⧷.\n\n")
    io.stderr:write("No shell escaping surprises, and the visually-related glyphs make the context obvious at a glance.\n\n")
    io.stderr:write("When --passthrough is used:\n")
    io.stderr:write("  - Original binary data is passed unchanged to stdout\n")
    io.stderr:write("  - Encoded representation is sent to stderr\n")
    io.stderr:write("  - This allows using the tool in pipelines to monitor binary data\n\n")
    io.stderr:write("Environment variables:\n")
    io.stderr:write("  PRINTABLE_BINARY_MAP        Override character map lookup path\n")
    io.stderr:write("  PRINTABLE_BINARY_MUTE_STATS Set to 1/true/yes to suppress stderr stats\n\n")
    io.stderr:write("Examples:\n")
    io.stderr:write("  " .. progname .. " binary_file               # Encode binary to UTF-8\n")
    io.stderr:write("  " .. progname .. " -d encoded_file           # Decode UTF-8 to binary\n")
    io.stderr:write("  " .. progname .. " -f=4x10 binary_file       # Encode with formatting\n")
    io.stderr:write("  " .. progname .. " --passthrough file | tool # Monitor binary stream\n")
  end

  local function debug_print(msg)
    if os.getenv("DEBUG") then
      io.stderr:write(msg .. "\n")
    end
  end

  local function read_file(path)
    debug_print("Opening " .. path)
    local file, err = io.open(path, "rb")
    if not file then
      io.stderr:write("Error opening file: " .. err .. "\n")
      os.exit(1)
    end
    local data = file:read("*a")
    file:close()
    return data
  end

  local function read_stdin()
    debug_print("Reading from stdin")
    return io.read("*a")
  end

  local function env_value_truthy(value)
    if not value then
      return false
    end

    local trimmed = value:match("^%s*(.-)%s*$") or value
    if trimmed == "" then
      return false
    end

    local lower = trimmed:lower()
    return lower == "1" or lower == "true" or lower == "yes"
  end

  local mute_stats = env_value_truthy(os.getenv("PRINTABLE_BINARY_MUTE_STATS"))

  local function stats_write(message)
    if not mute_stats then
      io.stderr:write(message)
    end
  end

  -- Main program
  if #arg == 0 then
    -- Check if stdin is a terminal
    local isatty = false
    local status, result = pcall(function() return io.stdin:isatty() end)
    if status and result then
      isatty = true
    end

    if isatty then
      print_usage()
      os.exit(0)
    end
  end

  -- Command line argument parsing
  local decode_mode = false
  local format_mode = false
  local file_path = nil
  local format_mode = false
  local format_spec = nil
  local passthrough_mode = false
  local spaces_mode = false

  -- Default formatting groups
  local format_group = 8
  local format_groups_per_line = 10
  local mappings_mode = nil

  local i = 1
  while i <= #arg do
    if arg[i] == "--help" or arg[i] == "-h" then
      print_usage()
      os.exit(0)
    elseif arg[i] == "--decode" or arg[i] == "-d" then
      decode_mode = true
    elseif arg[i] == "-p" or arg[i] == "--passthrough" then
      passthrough_mode = true
    elseif arg[i] == "-s" or arg[i] == "--spaces" then
      spaces_mode = true
    elseif arg[i] == "--format" or arg[i] == "-f" then
      format_mode = true
    elseif arg[i]:match("^%-f=") then
      format_mode = true
      format_spec = arg[i]:match("^%-f=(.*)")
      if format_spec then
        local group, groups_per_line = format_spec:match("(%d+)x(%d+)")
        if group and groups_per_line then
          format_group = tonumber(group)
          format_groups_per_line = tonumber(groups_per_line)
        else
          io.stderr:write("Invalid format specification: " .. format_spec .. "\n")
          io.stderr:write("Expected format like: -f=8x10 (groups of 8 chars, 10 groups per line)\n")
          print_usage()
          os.exit(1)
        end
      end
    elseif arg[i]:match("^%-%-format=") then
      format_mode = true
      format_spec = arg[i]:match("^%-%-format=(.*)")
      if format_spec then
        local group, groups_per_line = format_spec:match("(%d+)x(%d+)")
        if group and groups_per_line then
          format_group = tonumber(group)
          format_groups_per_line = tonumber(groups_per_line)
        else
          io.stderr:write("Invalid format specification: " .. format_spec .. "\n")
          io.stderr:write("Expected format like: -f=8x10 (groups of 8 chars, 10 groups per line)\n")
          print_usage()
          os.exit(1)
        end
      end
    elseif arg[i] == "--mappings" then
      if mappings_mode and mappings_mode ~= "table" then
        io.stderr:write("Only one mappings output mode can be specified\n")
        os.exit(1)
      end
      mappings_mode = "table"
    elseif arg[i] == "--mappings-json" then
      if mappings_mode and mappings_mode ~= "json" then
        io.stderr:write("Only one mappings output mode can be specified\n")
        os.exit(1)
      end
      mappings_mode = "json"
    elseif arg[i] == "--mappings-csv" then
      if mappings_mode and mappings_mode ~= "csv" then
        io.stderr:write("Only one mappings output mode can be specified\n")
        os.exit(1)
      end
      mappings_mode = "csv"
    elseif not file_path and not arg[i]:match("^%-") then
      file_path = arg[i]
    else
      io.stderr:write("Unknown option: " .. arg[i] .. "\n")
      print_usage()
      os.exit(1)
    end
    i = i + 1
  end

  if mappings_mode then
    output_mappings(mappings_mode)
    os.exit(0)
  end

  -- Read input data
  local input_data
  if file_path then
    input_data = read_file(file_path)
  else
    input_data = read_stdin()
  end

  -- Process data according to mode
  local output
  local output_already_written = false
  if decode_mode then
    -- Passthrough mode doesn't make sense in decode mode
    if passthrough_mode then
      io.stderr:write("Warning: --passthrough ignored in decode mode\n")
      passthrough_mode = false
    end

    stats_write("Decoding mode: Input size is " .. #input_data .. " bytes\n")

    if spaces_mode then
      warn_spaces_after_newline(input_data)
    end

    -- Simple whitespace removal - we need to preserve all other characters
    local cleaned_input
    if spaces_mode then
      cleaned_input = input_data:gsub("[\r\n\t]", "")
      stats_write("After whitespace removal (tabs/newlines/CR): " .. #cleaned_input .. " bytes\n")
    else
      cleaned_input = input_data:gsub("[\r\n\t ]", "")
      stats_write("After whitespace removal: " .. #cleaned_input .. " bytes\n")
    end

    -- Decode directly
    output = PrintableBinary.decode(cleaned_input, { spaces = spaces_mode, skip_clean = true })
    stats_write("Decoded result size: " .. #output .. " bytes\n")

    -- Always output decoded data to stdout in decode mode
    -- Passthrough mode doesn't apply to decode mode, as noted in the warning above
    io.stdout:write(output)

    -- Set a flag to prevent duplicate output later
    output_already_written = true
  else
    -- In passthrough mode, the original binary data goes to stdout
    if passthrough_mode then
      io.stdout:write(input_data)
    end
    output = PrintableBinary.encode(input_data, { spaces = spaces_mode })
    stats_write("Encoded " .. #input_data .. " bytes of input to " .. #output .. " bytes\n")

    -- Apply formatting if requested
    if format_mode and not decode_mode then
      local formatted_output = {}
      local char_count = 0
      local chars_in_group = 0
      local groups_in_line = 0
      local group_separator = spaces_mode and "\t" or " "

      -- We need to handle UTF-8 characters properly
      -- For each input byte, we have a corresponding UTF-8 output character
      -- So we can simply iterate through the input length to know how many
      -- "logical" characters we have in the output
      local original_len = #input_data

      for i = 1, original_len do
        -- Get the encoded character for this position
        -- and add it to the formatted output
        local byte = string.byte(input_data, i)
        local encoded_char
        if spaces_mode and byte == 32 then
          encoded_char = " "
        else
          encoded_char = encode_map[byte]
        end
        formatted_output[#formatted_output + 1] = encoded_char
        chars_in_group = chars_in_group + 1

        if chars_in_group == format_group then
          chars_in_group = 0
          groups_in_line = groups_in_line + 1

          if i < original_len then
            if groups_in_line == format_groups_per_line then
              formatted_output[#formatted_output + 1] = "\n"
              groups_in_line = 0
            else
              formatted_output[#formatted_output + 1] = group_separator
            end
          elseif groups_in_line == format_groups_per_line then
            groups_in_line = 0
          end
        end
      end

      output = table.concat(formatted_output)
    end
  end

  -- Handle output routing based on mode

  -- Check if we've already written output (in decode mode)
  if output_already_written then
    -- Skip output, it's already been written
  elseif decode_mode then
    -- Should never reach here due to output_already_written flag
    -- But just in case, don't write anything to avoid duplication
  elseif passthrough_mode then
    -- For encode mode with passthrough, send encoded output to stderr
    -- Binary data was already sent to stdout at line 369
    io.stderr:write(output)
  else
    -- Normal encode mode, send output to stdout
    io.write(output)
  end
end

return PrintableBinary
