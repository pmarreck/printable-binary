#!/usr/bin/env bash
# Master test runner for printable_binary
# Runs all test suites

set -e

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== PrintableBinary Test Suite Runner ===${NC}"

SCRIPT_DIR="$(dirname "$0")"

# Build the list of implementations to exercise with the core suite
if [ -n "$IMPLEMENTATION_TO_TEST" ]; then
  IMPLEMENTATIONS=("$IMPLEMENTATION_TO_TEST")
elif [ -n "$IMPLEMENTATIONS_TO_TEST" ]; then
  read -r -a IMPLEMENTATIONS <<<"$IMPLEMENTATIONS_TO_TEST"
else
  CANDIDATES=(
    "$SCRIPT_DIR/../bin/printable_binary"
    "$SCRIPT_DIR/../bin/printable_binary_c"
    "$SCRIPT_DIR/../bin/printable_binary_ape.com"
    "$SCRIPT_DIR/../bin/printable_binary_node.js"
  )
  IMPLEMENTATIONS=()
  for candidate in "${CANDIDATES[@]}"; do
    if [ -x "$candidate" ]; then
      IMPLEMENTATIONS+=("$candidate")
    fi
  done
fi

if [ "${#IMPLEMENTATIONS[@]}" -eq 0 ]; then
  echo -e "${RED}No printable_binary implementations found to test.${NC}"
  exit 1
fi

PRIMARY_IMPLEMENTATION="${IMPLEMENTATIONS[0]}"
echo -e "${YELLOW}Implementations under test:${NC}"
for impl in "${IMPLEMENTATIONS[@]}"; do
  echo " - $impl"
done

# Track success/failure
FAILED=0

# Run deterministic unit tests for each implementation
echo -e "\n${YELLOW}Running deterministic unit tests...${NC}"
for impl in "${IMPLEMENTATIONS[@]}"; do
  echo -e "${BLUE}-- Core suite against $impl --${NC}"
  if IMPLEMENTATION_TO_TEST="$impl" "$(dirname "$0")/test"; then
    echo -e "${GREEN}Unit tests: PASSED for $impl${NC}"
  else
    echo -e "${RED}Unit tests: FAILED for $impl${NC}"
    FAILED=1
  fi

  # If we're exercising the Cosmopolitan build, ensure it carries the Apple Silicon slice.
  if [[ "$impl" == *"printable_binary_ape.com" ]]; then
    if "$(dirname "$0")/test_ape_arch_slice" "$impl"; then
      echo -e "${GREEN}APE slice check: PASSED for $impl${NC}"
    else
      echo -e "${RED}APE slice check: FAILED for $impl${NC}"
      FAILED=1
    fi
  fi
done

# Passthrough functionality tests are now integrated into the main test suite
echo -e "\n${YELLOW}Passthrough functionality tests are integrated into the main test suite${NC}"
echo -e "${GREEN}Passthrough tests: INCLUDED IN MAIN TESTS${NC}"

# Run non-deterministic fuzz tests (primary implementation only to keep runtime reasonable)
echo -e "\n${YELLOW}Running non-deterministic fuzz tests (primary implementation only)...${NC}"
if IMPLEMENTATION_TO_TEST="$PRIMARY_IMPLEMENTATION" "$(dirname "$0")/fuzz_test"; then
  echo -e "${GREEN}Fuzz tests: PASSED${NC}"
else
  echo -e "${RED}Fuzz tests: FAILED${NC}"
  FAILED=1
fi

# Run disassembly tests
echo -e "\n${YELLOW}Running disassembly tests...${NC}"
if [[ "$PRIMARY_IMPLEMENTATION" == *"printable_binary_ape.com" ]]; then
  echo -e "${YELLOW}Skipping disassembly tests for APE build (popen/cstool not available in some environments)${NC}"
else
  if IMPLEMENTATION_TO_TEST="$PRIMARY_IMPLEMENTATION" "$(dirname "$0")/test_disassembly"; then
    echo -e "${GREEN}Disassembly tests: PASSED${NC}"
  else
    echo -e "${RED}Disassembly tests: FAILED${NC}"
    FAILED=1
  fi
fi

# Run performance benchmark tests
echo -e "\n${YELLOW}Running performance benchmark tests...${NC}"
if IMPLEMENTATION_TO_TEST="$PRIMARY_IMPLEMENTATION" "$(dirname "$0")/benchmark_test"; then
  echo -e "${GREEN}Benchmark tests: PASSED${NC}"
else
  echo -e "${RED}Benchmark tests: FAILED${NC}"
  FAILED=1
fi

# Run JavaScript implementation tests (if Deno is available)
echo -e "\n${YELLOW}Running JavaScript implementation tests...${NC}"
if command -v deno &> /dev/null; then
if PRINTABLE_BINARY_MAP="$SCRIPT_DIR/../character_map.txt" deno run --allow-read --allow-env "$SCRIPT_DIR/../test/js/test_printable_binary.js"; then
    echo -e "${GREEN}JavaScript tests: PASSED${NC}"
  else
    echo -e "${RED}JavaScript tests: FAILED${NC}"
    FAILED=1
  fi
else
  echo -e "${YELLOW}JavaScript tests: SKIPPED (Deno not found)${NC}"
fi

# Run WASM tests (requires wazero and printable_binary.wasm)
echo -e "\n${YELLOW}Running WASM tests...${NC}"
if "$SCRIPT_DIR/test_wasm"; then
  echo -e "${GREEN}WASM tests: PASSED${NC}"
else
  echo -e "${RED}WASM tests: FAILED${NC}"
  FAILED=1
fi

# Summary
echo -e "\n${BLUE}=== Test Suite Summary ===${NC}"
if [ $FAILED -eq 0 ]; then
  echo -e "${GREEN}All test suites passed!${NC}"
  exit 0
else
  echo -e "${RED}One or more test suites failed.${NC}"
  exit 1
fi
