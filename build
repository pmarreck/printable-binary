#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

log()  { printf '\033[1;34m[build]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[err]\033[0m %s\n' "$*"; }

has() { command -v "$1" >/dev/null 2>&1; }

# 1) Regenerate embedded map (cheap, keeps C/JS in sync)
if has luajit; then
  log "Regenerating embedded map (character_map_embedded.h)"
  luajit utils/generate_embedded_map.lua >/dev/null
else
  warn "luajit not found; skipping embedded map regeneration"
fi

# 2) C release build
log "Building C release binary"
make release

# 3) Web/WASM build (if emscripten available)
if has emcc; then
  log "Building WebAssembly module (emcc)"
  make wasm
else
  warn "emcc not found; skipping WASM build. Install Emscripten to enable."
fi

# 4) Cosmopolitan APE build (only supported on Linux x86_64)
OS="$(uname -s)"
ARCH="$(uname -m)"
if [[ "$OS" == "Linux" && "$ARCH" == "x86_64" ]]; then
  log "Building Cosmopolitan APE binary"
  CONFIRM_BIG_DEP_DOWNLOAD=1 make ape
else
  warn "APE build requires Linux x86_64 host; skipping on ${OS}/${ARCH}"
fi

# 5) Docs/JS bundle (static; nothing to build)
log "Docs are static; ensure character_map.txt is up to date (already linked)."

log "Build script finished."
